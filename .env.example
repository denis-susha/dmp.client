# Copy to .env.local (local development) or pass as Docker build args.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

# Host name used for SSR when the request Host header should be overridden (optional).
NEXT_PUBLIC_HOST=
# Public URL of dmp.api.web as seen from the browser (also hosts the SignalR /paymenthub).
NEXT_PUBLIC_API_HOST_URL=http://localhost:5005
# URL of dmp.api.web as seen from the Next.js server (SSR), e.g. http://dmp-api-web:80 inside Docker.
NEXT_INTERNAL_API_HOST_URL=http://localhost:5005
# Value sent in the Access-Control-Allow-Origin request header to the API.
NEXT_PUBLIC_ACCESS_CONTROL_ALLOW_ORIGIN=http://localhost:3000
# Object storage (MinIO / S3) base URL serving /images/** and /static/**.
NEXT_PUBLIC_IMAGES_HOST_URL=http://127.0.0.1:9000
# Public URL of the seller portal (dmp.seller).
NEXT_PUBLIC_SELLER_HOST_URL=http://seller.localhost
# Public URL of this storefront (used for canonical/OG URLs).
NEXT_PUBLIC_CLIENT_HOST_URL=http://localhost:3000
# Cloudflare Turnstile site key. The value below is Cloudflare's public "always passes" test key.
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
